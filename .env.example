# Entorno
NODE_ENV=production
PORT=3000

# URL de la Aplicación en Producción (Ej. https://mi-app.onrender.com)
FRONTEND_URL=http://localhost:3000

# Base de Datos (PostgreSQL URI)
DATABASE_URL=postgres://usuario:contraseña@host:5432/nombre_db

# LemonSqueezy (Suscripciones y Facturación)
LEMONSQUEEZY_API_KEY=tu_api_key_de_lemon_squeezy
LEMONSQUEEZY_STORE_ID=tu_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=secreto_generado_para_webhooks

# Email Service (Resend / Loops.so)
RESEND_API_KEY=tu_api_key_de_resend

# IA Reports (Gemini Pro)
GEMINI_API_KEY=tu_api_key_de_google_ai

# JWT Auth Secret (Generar uno aleatorio y seguro)
JWT_SECRET=super_secreto_para_produccion
